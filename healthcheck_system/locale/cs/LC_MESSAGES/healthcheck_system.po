#: healthcheck_system/free_ram.py:110 healthcheck_system/free_ram.py:97
msgid "System experiences memory shortage."
msgstr ""

#: healthcheck_system/free_storage.py:110 healthcheck_system/free_storage.py:81
msgid " out of "
msgstr ""

#: healthcheck_system/free_storage.py:112 healthcheck_system/free_storage.py:82
