#: healthcheck_setup/email_notifications.py:25
msgid "Checks if e-mail notifications are set up."
msgstr "Kontrollerar om e-postaviseringar är inställda."

#: healthcheck_setup/email_notifications.py:32
msgid "Set up e-mail notifications to be notified of router events"
msgstr "Ställ in e-postaviseringar att avisera om routerns händelser"

#: healthcheck_setup/email_notifications.py:35
msgid ""
"Turris system has notification system. Various components (including "
"healthcheck) are using it to inform the administrator of possible issues."
msgstr ""

#: healthcheck_setup/email_notifications.py:41
msgid ""
"Go to the \"Maintenance\" setting in Foris and set up e-mail "
"notifications there."
msgstr ""
"Gå till inställningen \"Underhåll\" i Foris och ställ in aviseringar via e-"
"post där."

#: healthcheck_setup/email_notifications.py:51
msgid "E-mail notifications will be sent out."
msgstr "Aviseringar via e-post kommer att skickas ut."

#: healthcheck_setup/email_notifications.py:54
msgid "Notifications are sent to the following e-mail addresses: "
msgstr "Aviseringar skickas till de följande e-postadresserna: "

#: healthcheck_setup/__init__.py:23
msgid "Suggestion for router setup."
msgstr "Förslag på hur man ställer in en router."
